/// Shop catalog SKU (PayPal NCP link, copy, image). Source of truth in DB;
/// seed rows ship from lib/merch/catalogSeed.ts on first load / migrate.
model MerchProduct {
  id                String     @id
  /// JSON string array of content org ids, e.g. ["ascension"]
  orgsJson          String
  name              String
  summary           String     @default("")
  description       String?
  priceCents        Int
  paypalUrl         String
  imageUrl          String?
  badge             String?
  /// JSON string array of checkout hint strings
  checkoutHintsJson String?
  maxQuantity       Int?
  /// shirt-orders | cap-orders | none
  fulfillment       String     @default("shirt-orders")
  /// Catalog retired flag (hidden everywhere except admin includeInactive)
  active            Boolean    @default(true)
  /// Runtime open/closed — false hides from public shop
  enabled           Boolean    @default(true)
  activeFrom        DateTime?
  activeTo          DateTime?
  sortOrder         Int        @default(100)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  updatedByAdminId  String?
  updatedByAdmin    AdminUser? @relation("MerchProductUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  @@index([active, enabled, sortOrder])
}

/// Legacy open/closed overlay (pre-DB catalog). Still applied when present so
/// existing toggles keep working; new writes go to MerchProduct.enabled.
model MerchProductStatus {
  id               String     @id @default(cuid())
  /// Matches MerchProduct.id
  productId        String     @unique
  /// false = closed / not taking orders (hidden from public shop)
  enabled          Boolean    @default(true)
  /// Optional window — same semantics as All-Star page links
  activeFrom       DateTime?
  activeTo         DateTime?
  updatedAt        DateTime   @updatedAt
  updatedByAdminId String?
  updatedByAdmin   AdminUser? @relation("MerchProductStatusUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  @@index([enabled])
}

/// Parent-submitted merch checkout draft (structured sizes) before PayPal payment.
/// Matched on sync/webhook when the PayPal note contains `code` (e.g. MO-AB12CD).
model MerchOrderDraft {
  id              String    @id @default(cuid())
  /// Short public code parents paste / we embed in the PayPal note (unique).
  code            String    @unique
  org             String // gonzales | ascension | fallball
  productId       String
  productName     String
  paypalUrl       String
  playerName      String
  /// Canonical size labels, one per shirt unit (JSON string array).
  sizesJson       String
  quantity        Int
  unitPriceCents  Int
  amountCents     Int
  contactEmail    String?
  /// Structured note for desk/export (also used if legacy NCP paste path is used).
  checkoutNote    String
  /// awaiting_payment | paid | expired | cancelled
  status          String    @default("awaiting_payment")
  /// PayPal Orders API order id (embedded checkout) — preferred match key.
  paypalOrderId   String?   @unique
  /// Capture / sale transaction id after payment.
  paypalTxId      String?   @unique
  paidAt          DateTime?
  createdByUserId String?
  createdByEmail  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  expiresAt       DateTime?

  @@index([org, status, createdAt])
  @@index([status, createdAt])
  @@index([productId])
}

model ParkInfoPage {
  id                  String     @id @default(cuid())
  organizationId      String     @unique
  rulesMarkdown       String     @default("")
  parkingMarkdown     String     @default("")
  fieldLayoutImageUrl String?
  updatedAt           DateTime   @updatedAt
  updatedByAdminId    String?
  updatedByAdmin      AdminUser? @relation("ParkInfoUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

// --- Volunteer Card / compliance tracking ---------------------------------

enum VolunteerProfileStatus {
  ACTIVE
  INACTIVE
}

enum VolunteerRequirementKey {
  JDP
  ABUSE_AWARENESS
}

enum VolunteerRequirementStatusValue {
  NOT_STARTED
  PENDING
  CLEAR
  EXPIRED
  FAILED
  WAIVED
}

/// Master Admin–managed catalog of volunteer roles (dropdown source of truth).
model VolunteerRoleDef {
  id               String   @id @default(cuid())
  /// Stable machine key, e.g. LEAGUE_HEAD_COACH (unique, uppercase slug).
  key              String   @unique
  label            String
  description      String?
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdByAdmin AdminUser?                @relation("VolunteerRoleDefCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  assignments    VolunteerRoleAssignment[]

  @@index([isActive, sortOrder])
}

/// One compliance card per registered user per org per season.
model VolunteerProfile {
  id               String                 @id @default(cuid())
  organizationId   String
  registeredUserId String
  seasonYear       Int
  status           VolunteerProfileStatus @default(ACTIVE)
  notes            String?
  /// Opaque badge mark (letter A). Master Admin toggle only — no public meaning.
  aMark            Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  registeredUser RegisteredUser               @relation(fields: [registeredUserId], references: [id], onDelete: Cascade)
  roles          VolunteerRoleAssignment[]
  requirements   VolunteerRequirementStatus[]

  @@unique([organizationId, registeredUserId, seasonYear])
  @@index([organizationId, seasonYear, status])
  @@index([registeredUserId])
}

model VolunteerRoleAssignment {
  id                 String   @id @default(cuid())
  volunteerProfileId String
  /// FK to VolunteerRoleDef.key (catalog managed by Master Admin).
  roleKey            String
  /// Optional team scope when the role is team-specific.
  teamId             String?
  createdAt          DateTime @default(now())

  volunteerProfile VolunteerProfile @relation(fields: [volunteerProfileId], references: [id], onDelete: Cascade)
  roleDef          VolunteerRoleDef @relation(fields: [roleKey], references: [key], onDelete: Restrict)

  @@unique([volunteerProfileId, roleKey, teamId])
  @@index([volunteerProfileId])
  @@index([roleKey])
}

/// Global requirement catalog (seeded). Org overrides can come later.
model VolunteerRequirementDef {
  key                   VolunteerRequirementKey @id
  label                 String
  description           String?
  requiredByDefault     Boolean                 @default(true)
  allowsVolunteerUpload Boolean                 @default(false)
  expiresAfterDays      Int?
  sortOrder             Int                     @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
}

model VolunteerRequirementStatus {
  id                 String                          @id @default(cuid())
  volunteerProfileId String
  requirementKey     VolunteerRequirementKey
  status             VolunteerRequirementStatusValue @default(NOT_STARTED)
  completedAt        DateTime?
  expiresAt          DateTime?
  externalRef        String?
  documentUrl        String?
  fileName           String?
  mimeType           String?
  uploadedAt         DateTime?
  reviewedByAdminId  String?
  reviewedAt         DateTime?
  notes              String?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  volunteerProfile VolunteerProfile @relation(fields: [volunteerProfileId], references: [id], onDelete: Cascade)
  reviewedByAdmin  AdminUser?       @relation("VolunteerRequirementReviewedBy", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@unique([volunteerProfileId, requirementKey])
  @@index([requirementKey, status])
  @@index([volunteerProfileId, status])
}

/// Saved SportsConnect division/team maps for an org+season (assisted import).
model SportsConnectMappingPreset {
  id               String   @id @default(cuid())
  organizationId   String
  seasonYear       Int
  name             String
  /// PLAYER_REG | COACH_VOLUNTEER | TEAM_LIST
  reportKind       String
  divisionMapping  Json
  teamMapping      Json
  columnOverrides  Json?
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdByAdmin AdminUser? @relation("SportsConnectMappingPresetCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@unique([organizationId, seasonYear, name, reportKind])
  @@index([organizationId, seasonYear])
}

/// Audit spine for SportsConnect-assisted import runs (links to existing batch tables).
model SportsConnectImportRun {
  id                String    @id @default(cuid())
  organizationId    String
  seasonYear        Int
  reportKind        String
  status            String    @default("PREVIEW")
  sourceFileName    String?
  presetId          String?
  summary           Json?
  errorMessage      String?
  teamPlayerBatchId String?
  coachBatchId      String?
  createdByAdminId  String?
  driveFileId       String?
  revisionToken     String?
  leaseExpiresAt    DateTime?
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  createdByAdmin AdminUser?   @relation("SportsConnectImportRunCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  enrollments    Enrollment[]

  @@unique([organizationId, seasonYear, driveFileId, revisionToken])
  @@index([organizationId, seasonYear, createdAt])
  @@index([organizationId, status, createdAt])
}

/// Durable source of truth for a single SportsConnect registration row (one
/// player, one season, one order line). Independent of Team/DraftPlayerPool
/// so registration/revenue KPIs are correct before any roster exists.
/// Additive alongside TeamPlayer — TeamPlayer remains the roster projection.
model Enrollment {
  id             String @id @default(cuid())
  organizationId String
  seasonYear     Int

  /// Within-season idempotent re-import key: "<orderNo>::<normalizedName>" or
  /// "<normalizedName>::<birthDateISO|nodob>" fallback. NOT a cross-season
  /// participant identity — SportsConnect exposes no persistent one.
  sportsConnectRowKey String

  programName     String?
  divisionNameRaw String?
  ageGroup        String
  teamNameRaw     String?
  teamId          String?

  firstName         String?
  lastName          String?
  fullName          String
  gender            String?
  birthDate         DateTime?
  guardianFirstName String?
  guardianLastName  String?
  guardianEmail     String?
  guardianPhone     String?
  contactPhone      String?
  streetAddress     String?
  unit              String?
  city              String?
  state             String?
  postalCode        String?

  // Financial ledger — *Cents convention per TournamentIncomeTransaction.
  sportsConnectOrderNo   String?
  orderDate              DateTime?
  orderDetailDescription String?
  orderPaymentStatus     String?
  amountCents            Int?
  amountPaidCents        Int?
  balanceCents           Int?

  /// Full-fidelity escape hatch: every raw column, verbatim, so a future
  /// report needing an unmapped column never requires a re-import.
  rawRow Json

  importRunId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team      Team?                   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  importRun SportsConnectImportRun? @relation(fields: [importRunId], references: [id], onDelete: SetNull)

  @@unique([organizationId, seasonYear, sportsConnectRowKey])
  @@index([organizationId, seasonYear, ageGroup])
  @@index([organizationId, seasonYear, teamId])
  @@index([organizationId, seasonYear, sportsConnectOrderNo])
  @@index([guardianEmail])
}

/// Explicit mapping of content organization to Google Drive export folder ID
model SportsConnectOrgDriveFolder {
  id             String   @id @default(cuid())
  organizationId String   @unique
  driveFolderId  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ── Travel / Regional trip intake (multi-org All-Star program) ───────────────

model TripFieldTemplate {
  id          String         @id @default(cuid())
  key         String         @unique
  name        String
  description String?
  fields      TripFieldDef[]
  events      TripEvent[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model TripFieldDef {
  id          String            @id @default(cuid())
  templateId  String
  template    TripFieldTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// Stable API key for answersJson
  key         String
  label       String
  /// Exact Google Sheet header for export
  sheetColumn String
  /// text|email|phone|date|select|checkbox|textarea|number|readonly
  fieldType   String
  required    Boolean           @default(false)
  /// JSON string array for select options
  optionsJson String?
  sortOrder   Int               @default(0)
  helpText    String?
  /// Prefill from participant: playerFullName|playerFirstName|playerLastName|ageGroup|team|jerseyNumber
  prefillFrom String?
  /// If true, only admins see/edit (not on parent form)
  adminOnly   Boolean           @default(false)

  @@unique([templateId, key])
  @@index([templateId, sortOrder])
}

model TripEvent {
  id             String            @id @default(cuid())
  organizationId String
  templateId     String
  template       TripFieldTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  name           String
  teamLabel      String?
  /// draft | open | closed
  status         String            @default("draft")
  opensAt        DateTime?
  closesAt       DateTime?
  googleSheetId  String?
  googleSheetUrl String?
  ballotCycleId  String?
  introMarkdown  String?
  participants   TripParticipant[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId, status])
  @@index([templateId])
}

model TripParticipant {
  id                String        @id @default(cuid())
  eventId           String
  event             TripEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizationId    String
  playerFullName    String
  ageGroup          String?
  team              String?
  jerseyNumber      String?
  candidateId       String?
  paymentId         String?
  inviteToken       String        @unique
  /// not_started | draft | submitted
  status            String        @default("not_started")
  /// Last successful invite email send (guardian)
  inviteEmailSentAt DateTime?
  inviteEmailTo     String?
  inviteEmailCount  Int           @default(0)
  response          TripResponse?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([eventId, status])
  @@index([organizationId, eventId])
}

model TripResponse {
  id             String          @id @default(cuid())
  participantId  String          @unique
  participant    TripParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  /// JSON object keyed by TripFieldDef.key
  answersJson    String          @default("{}")
  submitterName  String?
  submitterEmail String?
  submitterPhone String?
  submittedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

/// Master-Admin registration mode override. AUTO_SCHEDULED defers to the
/// start/end window below; the other three force a fixed public status.
enum RegistrationMode {
  AUTO_SCHEDULED
  OPEN
  WAITLIST
  CLOSED
}

/// Master-Admin-managed public registration open window (America/Chicago wall times).
/// Used by Fall Ball and other content orgs so open/close does not require a deploy.
model OrgRegistrationWindow {
  organizationId   String           @id
  /// Inclusive start, America/Chicago: YYYY-MM-DDTHH:mm:ss
  startLocal       String
  /// Inclusive end, America/Chicago: YYYY-MM-DDTHH:mm:ss
  endLocal         String
  mode             RegistrationMode @default(AUTO_SCHEDULED)
  updatedAt        DateTime         @updatedAt
  updatedByAdminId String?

  @@index([updatedAt])
}

enum SurveySeason {
  SPRING
  FALL
}

model Survey {
  id             String       @id @default(cuid())
  organizationId String // "fallball" | "district6" | "apbaseball"
  season         SurveySeason @default(SPRING)
  seasonYear     Int // 2026
  title          String
  description    String?
  slug           String
  isPublished    Boolean      @default(true)
  isAnonymous    Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sections  SurveySection[]
  responses SurveyResponse[]

  @@unique([organizationId, slug])
  @@index([organizationId, seasonYear, season])
}

model SurveySection {
  id          String  @id @default(cuid())
  surveyId    String
  survey      Survey  @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  order       Int     @default(0)
  title       String
  description String?

  questions SurveyQuestion[]

  @@index([surveyId, order])
}

model SurveyQuestion {
  id           String        @id @default(cuid())
  sectionId    String
  section      SurveySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  order        Int           @default(0)
  questionText String
  type         String // RATING | LIKERT_CHOICE | MATRIX | SINGLE_CHOICE | TEXT | CONDITIONAL_GATE
  isRequired   Boolean       @default(true)
  matrixTopics String[]      @default([])
  options      String[]      @default([])

  answers SurveyAnswer[]

  @@index([sectionId, order])
}

model SurveyResponse {
  id                String   @id @default(cuid())
  surveyId          String
  survey            Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  organizationId    String? // "gonzales", "ascension", or "fallball" (selected by respondent)
  respondentEmail   String?
  divisionName      String?
  ageGroup          String? // e.g., "6U", "8U", "10U"
  wantsBoardContact Boolean  @default(false)
  contactPhone      String?
  submittedAt       DateTime @default(now())

  /// Set when an admin marks this board-contact request as handled, via the
  /// cross-survey Board Contact Requests panel. Null means still open.
  contactedAt        DateTime?
  contactedByAdminId String?

  answers SurveyAnswer[]

  @@index([surveyId, submittedAt])
  @@index([surveyId, organizationId, submittedAt])
}

model SurveyAnswer {
  id          String         @id @default(cuid())
  responseId  String
  response    SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId  String
  question    SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  matrixTopic String?
  textValue   String?
  numberValue Float?
  stringValue String?

  @@index([responseId])
  @@index([questionId])
}

// ── Online Draft Module ───────────────────────────────────────────────────────

enum DraftType {
  SNAKE
  LINEAR
}

enum DraftSessionStatus {
  SETUP
  PAIRED
  LIVE
  PAUSED
  COMPLETED
  MATERIALIZED
}

enum DraftProtectionType {
  HEAD_COACH_CHILD
  ASSISTANT_COACH_CHILD
  PAIRING_REQUEST
  RETURNING_PLAYER
}

model DraftSession {
  id                String             @id @default(cuid())
  organizationId    String
  seasonYear        Int
  ageGroup          String
  name              String
  draftType         DraftType          @default(SNAKE)
  status            DraftSessionStatus @default(SETUP)
  secondsPerPick    Int?               @default(120)
  totalRounds       Int                @default(12)
  currentRound      Int                @default(1)
  currentPickIndex  Int                @default(0)
  createdByAdminId  String?
  draftLeaderUserId String?
  draftLeader       RegisteredUser?    @relation("DraftSessionLeader", fields: [draftLeaderUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  teams       DraftTeam[]
  playerPool  DraftPlayerPool[]
  picks       DraftPick[]
  protections CoachPlayerProtection[]

  @@index([organizationId, seasonYear, ageGroup])
  @@index([organizationId, status])
}

model DraftTeam {
  id              String   @id @default(cuid())
  draftSessionId  String
  teamName        String
  draftOrder      Int
  headCoachUserId String?
  assistantUserId String?
  targetTeamId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  draftSession   DraftSession            @relation(fields: [draftSessionId], references: [id], onDelete: Cascade)
  headCoach      RegisteredUser?         @relation("DraftTeamHeadCoach", fields: [headCoachUserId], references: [id], onDelete: SetNull)
  assistantCoach RegisteredUser?         @relation("DraftTeamAssistantCoach", fields: [assistantUserId], references: [id], onDelete: SetNull)
  picks          DraftPick[]
  protections    CoachPlayerProtection[]

  @@unique([draftSessionId, draftOrder])
  @@index([draftSessionId])
}

model CoachPlayerProtection {
  id               String              @id @default(cuid())
  draftSessionId   String
  draftTeamId      String
  registeredUserId String?
  playerName       String
  guardianEmail    String?
  protectionType   DraftProtectionType @default(HEAD_COACH_CHILD)
  protectedRound   Int                 @default(1)
  isClaimed        Boolean             @default(false)
  isOverridden     Boolean             @default(false)
  createdAt        DateTime            @default(now())

  draftSession DraftSession @relation(fields: [draftSessionId], references: [id], onDelete: Cascade)
  draftTeam    DraftTeam    @relation(fields: [draftTeamId], references: [id], onDelete: Cascade)

  @@index([draftSessionId])
  @@index([draftTeamId])
}

model DraftPlayerPool {
  id              String    @id @default(cuid())
  draftSessionId  String
  firstName       String?
  lastName        String?
  fullName        String
  guardianEmail   String?
  guardianPhone   String?
  birthDate       DateTime?
  evaluationScore Float?
  pitcherRating   Int?
  catcherRating   Int?
  notes           String?
  isDrafted       Boolean   @default(false)
  draftedTeamId   String?
  draftedPickId   String?
  createdAt       DateTime  @default(now())

  draftSession DraftSession @relation(fields: [draftSessionId], references: [id], onDelete: Cascade)

  @@index([draftSessionId, isDrafted])
}

model DraftPick {
  id              String   @id @default(cuid())
  draftSessionId  String
  round           Int
  overallPick     Int
  draftTeamId     String
  playerPoolId    String
  isProtectedPick Boolean  @default(false)
  pickedAt        DateTime @default(now())
  pickedByAdminId String?

  draftSession DraftSession @relation(fields: [draftSessionId], references: [id], onDelete: Cascade)
  draftTeam    DraftTeam    @relation(fields: [draftTeamId], references: [id], onDelete: Cascade)

  @@unique([draftSessionId, overallPick])
  @@index([draftSessionId])
}

model AllStarBallotCycle {
  id                      String              @id @default(cuid())
  organizationId          String
  seasonYear              Int
  ageGroup                String
  allStarAgeGroupId       String?
  allStarAgeGroupLabel    String?
  title                   String?
  hasShowcase             Boolean             @default(true)
  requiredRatingsPerCoach Int                 @default(12)
  status                  AllStarCycleStatus  @default(DRAFT)
  accessMode              AllStarAccessMode   @default(AGE_GROUP_COACHES)
  activePhase             AllStarBallotPhase  @default(FIRST_TEAM)
  secondPhaseGeneratedAt  DateTime?
  publishedAt             DateTime?
  closedAt                DateTime?
  /// One shared voting link per ballot; coaches authenticate with an email on the invite roster.
  ballotLinkToken         String?             @unique
  ballotLinkTokenHash     String?             @unique
  /// When this cycle was generated as a runoff from another ballot, links to the parent cycle.
  parentBallotCycleId     String?
  /// Declared runoff pool size (may exceed requested N when ties expand the pool at cutoff).
  runoffPoolSize          Int?
  /// Standings ranks 1..this size are "first team"; remainder are "second team" for exports and vault.
  runoffFirstTeamSize     Int?
  /// Admin-marked final vote metadata for configurable runoff / team-fill ballots.
  runoffIsFinalVote       Boolean             @default(false)
  runoffTeamTarget        AllStarBallotPhase?
  runoffPlayersNeeded     Int?
  createdByAdminId        String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  createdByAdmin       AdminUser?                   @relation("AllStarCycleCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  parentBallotCycle    AllStarBallotCycle?          @relation("AllStarBallotRunoffParent", fields: [parentBallotCycleId], references: [id], onDelete: SetNull)
  runoffChildCycles    AllStarBallotCycle[]         @relation("AllStarBallotRunoffParent")
  candidates           AllStarCandidate[]
  headCoachAssignments AllStarHeadCoachAssignment[]
  voteDrafts           AllStarVoteDraft[]
  voteSubmissions      AllStarVoteSubmission[]
  invites              AllStarInvite[]
  auditLogs            AllStarAuditLog[]
  payments             AllStarPayment[]

  @@index([organizationId, seasonYear, ageGroup])
  @@index([organizationId, status, ageGroup])
  @@index([organizationId, seasonYear, allStarAgeGroupId])
  @@index([parentBallotCycleId])
}

model AllStarCandidate {
  id                           String                      @id @default(cuid())
  ballotCycleId                String

model ShirtOrderItem {
  id          String           @id @default(cuid())
  orderId     String
  order       ShirtOrderRecord @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seq         Int
  /// Canonical size for this unit (admin-editable). When null, UI falls back to parsing order.note.
  sizeLabel   String?
  status      String           @default("open")
  fulfilledAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([orderId, seq])
  @@index([orderId])
  @@index([status])

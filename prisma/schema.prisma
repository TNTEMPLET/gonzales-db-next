  updatedAt          DateTime @updatedAt

  park           SchedulePark                @relation(fields: [parkId], references: [id], onDelete: Cascade)
  availabilities ScheduleFieldAvailability[]
  divisionRules  ScheduleDivisionRule[]
  draftGames     ScheduleDraftGame[]
  practiceSlots  TeamPracticeSlot[]

  @@unique([parkId, name])
  @@index([organizationId, isActive])
  @@index([parkId, isActive, name])
}

/// A recurring weekly practice slot assigned to an already-real Team
/// (post-draft-materialization), reusing the same SchedulePark/ScheduleField
/// facility catalog games use. Deliberately not exploded into dated
/// occurrences like ScheduleFieldAvailability -- Coach Corner and the
/// Practice Matrix report only ever need "Tuesdays 5:45pm, Field 3", not a
/// literal calendar. Writing/updating a slot regenerates the owning team's
/// Team.practicePlan text (lib/scheduler/practicePlanText.ts) so coaches see
/// it immediately with no new coach-facing UI.
model TeamPracticeSlot {
  id                 String         @id @default(cuid())
  organizationId     String
  seasonYear         Int
  ageGroup           String
  teamId             String
  team               Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  parkId             String?
  park               SchedulePark?  @relation(fields: [parkId], references: [id], onDelete: SetNull)
  fieldId            String?
  field              ScheduleField? @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  dayOfWeek          Int // 0 (Sunday) - 6 (Saturday), recurring weekly
  startTime          String // "17:45"
  durationMinutes    Int            @default(90)
  /// Two teams sharing one field/night (first team gets the field for
  /// durationMinutes, then swaps) share this same value.
  sharedFieldGroupId String?
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([organizationId, seasonYear, ageGroup])
  @@index([sharedFieldGroupId])
}

model ScheduleFieldAvailability {
  id               String                   @id @default(cuid())
  organizationId   String
  seasonId         String?
  parkId           String
  fieldId          String?
  availabilityType ScheduleAvailabilityType @default(AVAILABLE)
  date             DateTime?
  dayOfWeek        Int?
  startTime        String?
  endTime          String?
  notes            String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  season ScheduleSeason? @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  park   SchedulePark    @relation(fields: [parkId], references: [id], onDelete: Cascade)
  field  ScheduleField?  @relation(fields: [fieldId], references: [id], onDelete: SetNull)

  @@index([organizationId, seasonId, availabilityType], map: "SchedAvail_org_season_type_idx")
  @@index([parkId, date])
  @@index([fieldId, date])
  @@index([organizationId, dayOfWeek, startTime], map: "SchedAvail_org_day_start_idx")
}

model ScheduleDivisionRule {
  id                  String   @id @default(cuid())
  organizationId      String
  seasonId            String
  division            String
  ageGroup            String?
  preferredParkId     String?
  preferredFieldId    String?
  allowedParkIds      Json     @default("[]")
  allowedFieldIds     Json     @default("[]")
  allowedGameTimes    Json     @default("[]")
  minDaysBetweenGames Int?
  maxGamesPerWeek     Int?
  avoidBackToBack     Boolean  @default(true)
  ruleMetadata        Json     @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  season         ScheduleSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  preferredPark  SchedulePark?  @relation(fields: [preferredParkId], references: [id], onDelete: SetNull)
  preferredField ScheduleField? @relation(fields: [preferredFieldId], references: [id], onDelete: SetNull)

  @@index([organizationId, seasonId, division])
  @@index([preferredParkId])
  @@index([preferredFieldId])
}

model ScheduleDraftGame {
  id               String                  @id @default(cuid())
  organizationId   String
  seasonId         String
  gameDate         DateTime?
  startTime        String?
  endTime          String?
  parkId           String?
  fieldId          String?
  division         String
  ageGroup         String?
  homeTeamId       String?
  awayTeamId       String?
  homeTeamName     String
  awayTeamName     String
  status           ScheduleDraftGameStatus @default(DRAFT)
  source           String                  @default("generated")
  roundLabel       String?
  gameNumber       Int?
  sortOrder        Int                     @default(0)
  conflictFlags    Json                    @default("[]")
  fairnessScore    Float?
  fairnessMetadata Json                    @default("{}")
  schedulerNotes   String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  season   ScheduleSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  park     SchedulePark?  @relation(fields: [parkId], references: [id], onDelete: SetNull)
  field    ScheduleField? @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  homeTeam Team?          @relation("ScheduleDraftGameHomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeam Team?          @relation("ScheduleDraftGameAwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)

  @@index([organizationId, seasonId, status, gameDate], map: "SchedDraftGame_org_season_status_date_idx")
  @@index([seasonId, division, gameDate])
  @@index([parkId, gameDate, startTime])
  @@index([fieldId, gameDate, startTime])
  @@index([homeTeamId, gameDate])
  @@index([awayTeamId, gameDate])
}

model ScheduleExportBatch {
  id               String                    @id @default(cuid())
  organizationId   String
  seasonId         String
  status           ScheduleExportBatchStatus @default(PENDING)
  format           String                    @default("CSV")

  finalRosterOverrideByAdminId String?
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt

  ballotCycle                AllStarBallotCycle @relation(fields: [ballotCycleId], references: [id], onDelete: Cascade)
  secondPhaseOverrideByAdmin AdminUser?         @relation("AllStarSecondPhaseOverrideByAdmin", fields: [secondPhaseOverrideByAdminId], references: [id], onDelete: SetNull)
  finalRosterOverrideByAdmin AdminUser?         @relation("AllStarFinalRosterOverrideByAdmin", fields: [finalRosterOverrideByAdminId], references: [id], onDelete: SetNull)
  voteItems                  AllStarVoteItem[]
  payments                   AllStarPayment[]

  @@index([ballotCycleId, team])
  @@index([organizationId, ageGroup, playerFullName])
  @@index([ballotCycleId, finalRosterOverride])
}


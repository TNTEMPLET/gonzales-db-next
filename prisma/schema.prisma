/// One equipment kit (tee/balls/gear, tiered by division) checked out to a
/// team's head coach for the season. Flat, one row per team -- unlike Cap/
/// ShirtOrder's parent+item shape (N identical physical units needing N
/// individual fulfillment marks), a team gets exactly one kit.
model EquipmentCheckout {
  id              String    @id @default(cuid())
  organizationId  String
  seasonYear      Int
  ageGroup        String
  teamId          String    @unique
  team            Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignedCoachId String? // RegisteredUser, resolved at creation time from TeamCoachAssignment
  kitLabel        String
  status          String    @default("open") // "open" | "picked_up"
  pickedUpAt      DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([organizationId, seasonYear, ageGroup])
  @@index([status])
}


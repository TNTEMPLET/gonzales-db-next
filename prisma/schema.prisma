  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  completedAt      DateTime?

  createdByAdmin AdminUser?        @relation("AssignrSyncJobCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  auditLogs      AssignrAuditLog[]

  @@index([organizationId, status, createdAt])
}

model AssignrAuditLog {
  id                String   @id @default(cuid())
  organizationId    String
  action            String
  assignrResource   String
  assignrResourceId String?
  requestSummary    Json?
  responseSummary   Json?
  success           Boolean
  errorMessage      String?
  adminUserId       String?
  syncJobId         String?
  createdAt         DateTime @default(now())

  adminUser AdminUser?      @relation("AssignrAuditActor", fields: [adminUserId], references: [id], onDelete: SetNull)
  syncJob   AssignrSyncJob? @relation(fields: [syncJobId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([syncJobId])
}

enum ScheduleManagerJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

enum ScheduleManagerJobMode {
  DRY_RUN
  LIVE
  CRON
}

enum ScheduleManagerActionStatus {
  PLANNED
  DRY_RUN
  CREATED
  SKIPPED
  FAILED
}

model ScheduleManagerJob {
  id               String                   @id @default(cuid())
  organizationId   String
  mode             ScheduleManagerJobMode
  status           ScheduleManagerJobStatus @default(PENDING)
  totalCount       Int                      @default(0)
  createdCount     Int                      @default(0)
  skippedCount     Int                      @default(0)
  failedCount      Int                      @default(0)
  payload          Json?
  results          Json?
  errorMessage     String?
  createdByAdminId String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  completedAt      DateTime?

  createdByAdmin AdminUser?              @relation("ScheduleManagerJobCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  actions        ScheduleManagerAction[]

  @@index([organizationId, status, createdAt])
  @@index([createdByAdminId])
}

model ScheduleManagerAction {
  id                 String                      @id @default(cuid())
  jobId              String?
  organizationId     String
  bracketProjectId   String
  matchId            String
  divisionLabel      String?
  gameNumber         String?
  scheduledFor       DateTime?
  field              String?
  homeTeam           String
  awayTeam           String
  status             ScheduleManagerActionStatus @default(PLANNED)
  gameChangerEventId String?
  requestSummary     Json?
  responseSummary    Json?
  errorMessage       String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  job            ScheduleManagerJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  bracketProject BracketProject      @relation(fields: [bracketProjectId], references: [id], onDelete: Cascade)

  @@unique([bracketProjectId, matchId])
  @@index([organizationId, status, createdAt])
  @@index([jobId])
  @@index([bracketProjectId])
}

enum TournamentMonitorRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

enum TournamentMonitorEventType {
  SITE_DOWN
  SITE_RECOVERED
  LIVE_HEARTBEAT
  GAME_LIVE
  GAME_FINAL
  GC_GAME_CREATED
  GC_GAME_CREATE_WARNING
  GC_GAME_CREATE_FAILED
}

model TournamentMonitorSubscription {
  id        String                 @id @default(cuid())
  name      String
  email     String?
  phone     String?
  channels  CommunicationChannel[]
  active    Boolean                @default(true)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([active])
  @@index([email])
  @@index([phone])
}

model TournamentMonitorRun {
  id           String                     @id @default(cuid())
  status       TournamentMonitorRunStatus @default(PENDING)
  checkedCount Int                        @default(0)
  eventCount   Int                        @default(0)
  sentCount    Int                        @default(0)
  failedCount  Int                        @default(0)
  errorMessage String?
  results      Json?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  completedAt  DateTime?

  events TournamentMonitorEvent[]

  @@index([status, createdAt])
}

model TournamentMonitorEvent {
  id               String                     @id @default(cuid())
  runId            String?
  type             TournamentMonitorEventType
  organizationId   String
  bracketProjectId String?
  matchId          String?
  eventKey         String
  statusHash       String
  title            String
  message          String
  payload          Json?
  emailSentCount   Int                        @default(0)
  smsSentCount     Int                        @default(0)
  failedCount      Int                        @default(0)
  sentAt           DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  run            TournamentMonitorRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  bracketProject BracketProject?       @relation(fields: [bracketProjectId], references: [id], onDelete: Cascade)

  @@unique([eventKey])
  @@index([type, createdAt])
  @@index([organizationId, type, createdAt])
  @@index([bracketProjectId, matchId, type])
  @@index([runId])
}

model OrgAlert {
  id             String   @id @default(cuid())
  organizationId String
  allParksOut    Boolean  @default(true)
  /**
   * JSON string array — stored as Json because Prisma PPG adapter mishandles Postgres text[].
   */
  venues         Json     @default("[]")
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([organizationId, expiresAt])
}

model SocialPost {
  id                 String           @id @default(cuid())
  /**
   * Always `ap-baseball`: shared AP Baseball Facebook Page, not per league site.
   */
  organizationId     String           @default("ap-baseball")
  status             SocialPostStatus @default(DRAFT)
  body               String
  linkUrl            String?
  imageUrl           String?
  facebookPostId     String?
  publishError       String?
  publishedAt        DateTime?
  scheduledFor       DateTime?
  createdByAdminId   String?
  /**
   * True when this row was first created from a Facebook Page feed sync (not composed in admin).
   */
  syncedFromFacebook Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  createdByAdmin AdminUser? @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@unique([organizationId, facebookPostId])
  @@index([organizationId, status, updatedAt])
}

/// Per-org configuration for the public All-Star information page.
model AllStarPageConfig {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  /// Customizable label shown on the PayPal button (e.g. "2026 All-Star Fee Payment")
  paypalLinkLabel String?
  /// Full PayPal payment URL
  paypalLinkUrl   String?
  /// Plain-text announcement / info paragraph shown at the top of the page
  infoText        String?
  /// Additional purchasable items: JSON array of { label: string, url: string }
  links           Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Fee payment record for a player selected for All-Stars. Populated from the ballot cycle
/// roster and reconciled against PayPal transactions.
model AllStarPayment {
  id                  String    @id @default(cuid())
  organizationId      String
  ballotCycleId       String
  /// Linked candidate – null if manually added outside ballot cycle roster.
  candidateId         String?
  playerFullName      String
  ageGroup            String
  team                String
  /// Payer name as reported by PayPal (filled during sync).
  payerName           String?
  /// PayPal transaction ID (filled during sync).
  paypalTxId          String?
  /// Date/time of the PayPal payment (filled during sync).
  paypalTxDate        DateTime?
  /// Raw PayPal memo / note field used for player matching.
  paypalNote          String?
  /// Amount in cents (default 9500 = 5.00).
  amountCents         Int       @default(9500)
  isPaid              Boolean   @default(false)
  paidAt              DateTime?
  markedPaidByAdminId String?
  /// Optional free-text note from admin.
  notes               String?
  /// Roster label grouping payments (e.g. "2026 — 11U LLB — Navy"). Null for legacy records.
  rosterTag           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  ballotCycle       AllStarBallotCycle @relation(fields: [ballotCycleId], references: [id], onDelete: Cascade)
  candidate         AllStarCandidate?  @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  markedPaidByAdmin AdminUser?         @relation("AllStarPaymentMarkedPaidBy", fields: [markedPaidByAdminId], references: [id], onDelete: SetNull)

  /// One record per candidate per cycle; manual records (candidateId null) have no uniqueness constraint.
  @@unique([ballotCycleId, candidateId])
  @@index([organizationId, ballotCycleId])
  @@index([ballotCycleId, isPaid])
}

// ─── Parent Cap Orders ────────────────────────────────────────────────────────

model CapOrderRecord {
  id          String   @id @default(cuid())
  txId        String   @unique
  org         String // "gonzales" | "ascension" | "unknown"
  payerName   String?
  payerEmail  String?
  amountCents Int
  quantity    Int      @default(1)
  note        String?
  itemName    String?
  txDate      DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items CapOrderItem[]

  @@index([org, txDate])
  @@index([txDate])
}

model CapOrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       CapOrderRecord @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seq         Int
  status      String         @default("open")
  fulfilledAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([orderId, seq])
  @@index([orderId])
  @@index([status])
}

model ParkInfoPage {
  id                  String     @id @default(cuid())
  organizationId      String     @unique
  rulesMarkdown       String     @default("")
  parkingMarkdown     String     @default("")
  fieldLayoutImageUrl String?
  updatedAt           DateTime   @updatedAt
  updatedByAdminId    String?
  updatedByAdmin      AdminUser? @relation("ParkInfoUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

// --- Volunteer Card / compliance tracking ---------------------------------

enum VolunteerProfileStatus {
  ACTIVE
  INACTIVE
}

enum VolunteerRequirementKey {
  JDP
  ABUSE_AWARENESS
}

enum VolunteerRequirementStatusValue {
  NOT_STARTED
  PENDING
  CLEAR
  EXPIRED
  FAILED
  WAIVED
}

/// Master Admin–managed catalog of volunteer roles (dropdown source of truth).
model VolunteerRoleDef {
  id               String   @id @default(cuid())
  /// Stable machine key, e.g. LEAGUE_HEAD_COACH (unique, uppercase slug).
  key              String   @unique
  label            String
  description      String?
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdByAdmin AdminUser?               @relation("VolunteerRoleDefCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  assignments    VolunteerRoleAssignment[]

  @@index([isActive, sortOrder])
}

/// One compliance card per registered user per org per season.
model VolunteerProfile {
  id               String                 @id @default(cuid())
  organizationId   String
  registeredUserId String
  seasonYear       Int
  status           VolunteerProfileStatus @default(ACTIVE)
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  registeredUser RegisteredUser              @relation(fields: [registeredUserId], references: [id], onDelete: Cascade)
  roles          VolunteerRoleAssignment[]
  requirements   VolunteerRequirementStatus[]

  @@unique([organizationId, registeredUserId, seasonYear])
  @@index([organizationId, seasonYear, status])
  @@index([registeredUserId])
}

model VolunteerRoleAssignment {
  id                 String  @id @default(cuid())
  volunteerProfileId String
  /// FK to VolunteerRoleDef.key (catalog managed by Master Admin).
  roleKey            String
  /// Optional team scope when the role is team-specific.
  teamId             String?
  createdAt          DateTime @default(now())

  volunteerProfile VolunteerProfile @relation(fields: [volunteerProfileId], references: [id], onDelete: Cascade)
  roleDef          VolunteerRoleDef @relation(fields: [roleKey], references: [key], onDelete: Restrict)

  @@unique([volunteerProfileId, roleKey, teamId])
  @@index([volunteerProfileId])
  @@index([roleKey])
}

/// Global requirement catalog (seeded). Org overrides can come later.
model VolunteerRequirementDef {
  key                   VolunteerRequirementKey @id
  label                 String
  description           String?
  requiredByDefault     Boolean                 @default(true)
  allowsVolunteerUpload Boolean                 @default(false)
  expiresAfterDays      Int?
  sortOrder             Int                     @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
}

model VolunteerRequirementStatus {
  id                 String                           @id @default(cuid())
  volunteerProfileId String
  requirementKey     VolunteerRequirementKey
  status             VolunteerRequirementStatusValue  @default(NOT_STARTED)
  completedAt        DateTime?
  expiresAt          DateTime?
  externalRef        String?
  documentUrl        String?
  fileName           String?
  mimeType           String?
  uploadedAt         DateTime?
  reviewedByAdminId  String?
  reviewedAt         DateTime?
  notes              String?
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt

  volunteerProfile VolunteerProfile @relation(fields: [volunteerProfileId], references: [id], onDelete: Cascade)
  reviewedByAdmin  AdminUser?       @relation("VolunteerRequirementReviewedBy", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@unique([volunteerProfileId, requirementKey])
  @@index([requirementKey, status])
  @@index([volunteerProfileId, status])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

enum AdminAuditAction {
  PROMOTE
  DEMOTE
  BLOCK
  UNBLOCK
  REMOVE
  GRANT_MASTER
  REVOKE_MASTER
}

enum AdminRole {
  MASTER_ADMIN
  ADMIN
  BOARD_MEMBER
  PARK_DIRECTOR
}

enum AllStarCycleStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum AllStarAccessMode {
  INVITE_LIST
  AGE_GROUP_COACHES
}

enum AllStarVaultRole {
  FULL_ACCESS
  VIEW_ONLY
}

enum TeamCoachRole {
  HEAD_COACH
  ASSISTANT_COACH
}

enum SponsorPackageType {
  BALLPARK_FENCE_SIGNS
  TEAM_SPONSORSHIPS
  FIELD_SPONSORSHIPS
  CUSTOM
}

enum DugoutMediaType {
  IMAGE
  GIF
}

enum DugoutNotificationEntityType {
  POST_LIKE
  COMMENT
}

enum SocialPostStatus {
  DRAFT
  PUBLISHING
  PUBLISHED
  FAILED
}

model NewsPost {
  id             String     @id @default(cuid())
  organizationId String     @default("gonzales")
  title          String
  slug           String
  excerpt        String?
  content        String
  imageUrl       String?
  author         String?
  featured       Boolean    @default(false)
  rotatorEnabled Boolean    @default(false)
  status         NewsStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId, status, publishedAt])
  @@index([organizationId, slug])
}

model AdminUser {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String?
  firstName    String?
  lastName     String?
  role         AdminRole       @default(ADMIN)
  isMaster     Boolean         @default(false)
  passwordHash String?
  avatarUrl    String?
  /// Set when the admin signs in with Google; required to open org Drive files in the browser.
  googleSub    String?         @unique
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     AdminSession[]
  auditLogs    AdminAuditLog[] @relation("AdminActorLogs")
  enteredScores GameScore[]
  coachImportBatches CoachImportBatch[]
  allStarBallotCycles AllStarBallotCycle[] @relation("AllStarCycleCreatedBy")
  allStarHeadCoachAssignments AllStarHeadCoachAssignment[] @relation("AllStarHeadCoachAdmin")
  allStarInvites AllStarInvite[] @relation("AllStarInviteCreatedByAdmin")
  allStarVaultAccessGrants AllStarVaultAccess[] @relation("AllStarVaultAccessGrantedByAdmin")
  teamsCreated Team[]
  teamPlayerImportBatches TeamPlayerImportBatch[]
  socialPostsCreated      SocialPost[]
}

model RegisteredUser {
  id             String   @id @default(cuid())
  organizationId String   @default("gonzales")
  email          String
  name           String?
  firstName      String?
  lastName       String?
  isCoach        Boolean  @default(false)
  isBlocked      Boolean  @default(false)
  contactPhone   String?
  ageGroup       String?
  assignedTeam   String?
  googleSub      String?  @unique
  passwordHash   String?
  avatarUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  auditLogs    AdminAuditLog[]
  sessions     CoachSession[]
  dugoutPosts  DugoutPost[]
  dugoutComments DugoutComment[]
  dugoutLikes  DugoutPostLike[]
  dugoutNotificationCursor DugoutNotificationCursor?
  dugoutNotificationReads DugoutNotificationRead[]
  allStarVoteDrafts AllStarVoteDraft[]
  allStarVoteSubmissions AllStarVoteSubmission[]
  allStarHeadCoachAssignments AllStarHeadCoachAssignment[] @relation("AllStarHeadCoachRegisteredUser")
  allStarInvites AllStarInvite[] @relation("AllStarInviteRegisteredUser")
  allStarVaultAccess AllStarVaultAccess[]
  teamCoachAssignments TeamCoachAssignment[]
  teamGameNotes TeamGameNote[] @relation("TeamGameNoteAuthor")

  @@unique([organizationId, email])
  @@index([organizationId])
}

model CoachSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      RegisteredUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model DugoutPost {
  id             String          @id @default(cuid())
  organizationId String          @default("gonzales")
  content        String
  mediaUrl       String?
  mediaType      DugoutMediaType?
  threadId       String?
  threadOrder    Int?
  isPinned       Boolean         @default(false)
  pinnedAt       DateTime?
  authorId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  author RegisteredUser   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments DugoutComment[]
  likes  DugoutPostLike[]

  @@index([organizationId, createdAt])
  @@index([authorId])
  @@index([threadId, threadOrder])
  @@index([isPinned, pinnedAt])
}

model DugoutComment {
  id        String   @id @default(cuid())
  content   String
  mediaUrl  String?
  mediaType DugoutMediaType?
  postId    String
  authorId  String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post    DugoutPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  RegisteredUser   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  DugoutComment?   @relation("DugoutCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies DugoutComment[]  @relation("DugoutCommentReplies")
  notificationReads DugoutNotificationRead[] @relation("NotificationReadComment")

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId])
}

model DugoutPostLike {
  id        String         @id @default(cuid())
  postId    String
  userId    String
  reaction  String         @default("👍")
  createdAt DateTime       @default(now())

  post DugoutPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user RegisteredUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationReads DugoutNotificationRead[] @relation("NotificationReadLike")

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model DugoutNotificationCursor {
  id         String   @id @default(cuid())
  userId     String   @unique
  lastSeenAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user RegisteredUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastSeenAt])
}

model DugoutNotificationRead {
  id         String                        @id @default(cuid())
  userId     String
  entityType DugoutNotificationEntityType
  postLikeId String?
  commentId  String?
  readAt     DateTime                      @default(now())

  user     RegisteredUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  postLike DugoutPostLike? @relation("NotificationReadLike", fields: [postLikeId], references: [id], onDelete: Cascade)
  comment  DugoutComment?  @relation("NotificationReadComment", fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postLikeId])
  @@unique([userId, commentId])
  @@index([userId, readAt])
  @@index([entityType, readAt])
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AdminAuditLog {
  id                     String            @id @default(cuid())
  action                 AdminAuditAction
  actorAdminId           String?
  actorEmail             String
  targetAdminId          String?
  targetRegisteredUserId String?
  targetEmail            String
  targetName             String?
  sourcePath             String?
  requestIp              String?
  createdAt              DateTime          @default(now())

  actorAdmin            AdminUser?       @relation("AdminActorLogs", fields: [actorAdminId], references: [id], onDelete: SetNull)
  targetRegisteredUser RegisteredUser? @relation(fields: [targetRegisteredUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
}

model GameScore {
  id             String    @id @default(cuid())
  organizationId String    @default("gonzales")
  gameExternalId String
  ageGroup       String?
  homeTeam       String
  awayTeam       String
  gameDate       DateTime?
  homeScore      Int
  awayScore      Int
  enteredByAdminId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  enteredByAdmin AdminUser? @relation(fields: [enteredByAdminId], references: [id], onDelete: SetNull)

  @@unique([organizationId, gameExternalId])
  @@index([organizationId, ageGroup])
  @@index([organizationId, gameDate])
}

model CoachImportBatch {
  id             String   @id @default(cuid())
  organizationId String
  createdByAdminId String?
  createdByEmail String?
  createdCount   Int      @default(0)
  updatedCount   Int      @default(0)
  processedCount Int      @default(0)
  skippedCount   Int      @default(0)
  undoPayload    Json
  undoneAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdByAdmin AdminUser? @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, undoneAt, createdAt])
}

model AllStarBallotCycle {
  id            String            @id @default(cuid())
  organizationId String
  seasonYear    Int
  ageGroup      String
  title         String?
  hasShowcase   Boolean           @default(true)
  status        AllStarCycleStatus @default(DRAFT)
  accessMode    AllStarAccessMode  @default(AGE_GROUP_COACHES)
  publishedAt   DateTime?
  closedAt      DateTime?
  createdByAdminId String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  createdByAdmin      AdminUser?                  @relation("AllStarCycleCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  candidates          AllStarCandidate[]
  headCoachAssignments AllStarHeadCoachAssignment[]
  voteDrafts          AllStarVoteDraft[]
  voteSubmissions     AllStarVoteSubmission[]
  invites             AllStarInvite[]

  @@unique([organizationId, seasonYear, ageGroup])
  @@index([organizationId, status, ageGroup])
}

model AllStarCandidate {
  id                String   @id @default(cuid())
  ballotCycleId     String
  organizationId    String
  ageGroup          String
  playerFullName    String
  team              String
  jerseyNumber      String
  showcaseBibNumber String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  ballotCycle AllStarBallotCycle @relation(fields: [ballotCycleId], references: [id], onDelete: Cascade)
  voteItems   AllStarVoteItem[]

  @@index([ballotCycleId, team])
  @@index([organizationId, ageGroup, playerFullName])
}

model AllStarHeadCoachAssignment {
  id                String   @id @default(cuid())
  ballotCycleId     String
  organizationId    String
  ageGroup          String
  registeredUserId  String?
  adminUserId       String?
  coachName         String?
  coachEmail        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  ballotCycle    AllStarBallotCycle @relation(fields: [ballotCycleId], references: [id], onDelete: Cascade)
  registeredUser RegisteredUser?    @relation("AllStarHeadCoachRegisteredUser", fields: [registeredUserId], references: [id], onDelete: SetNull)
  adminUser      AdminUser?         @relation("AllStarHeadCoachAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([ballotCycleId])
  @@index([organizationId, ageGroup])
}

model AllStarVoteDraft {
  id               String   @id @default(cuid())
  ballotCycleId    String
  coachUserId      String
  organizationId   String
  ageGroup         String
  ratingsPayload   Json
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  ballotCycle AllStarBallotCycle @relation(fields: [ballotCycleId], references: [id], onDelete: Cascade)
  coachUser   RegisteredUser      @relation(fields: [coachUserId], references: [id], onDelete: Cascade)

  @@unique([ballotCycleId, coachUserId])
  @@index([organizationId, ageGroup])
}

model AllStarVoteSubmission {
  id               String   @id @default(cuid())
  ballotCycleId    String
  coachUserId      String
  organizationId   String
  ageGroup         String
  submittedAt      DateTime @default(now())
  createdAt        DateTime @default(now())

  ballotCycle AllStarBallotCycle @relation(fields: [ballotCycleId], references: [id], onDelete: Cascade)
  coachUser   RegisteredUser      @relation(fields: [coachUserId], references: [id], onDelete: Cascade)
  voteItems   AllStarVoteItem[]

  @@unique([ballotCycleId, coachUserId])
  @@index([organizationId, ageGroup, submittedAt])
}

model AllStarVoteItem {
  id                String   @id @default(cuid())
  voteSubmissionId  String
  candidateId       String
  rating            Int
  createdAt         DateTime @default(now())

  voteSubmission AllStarVoteSubmission @relation(fields: [voteSubmissionId], references: [id], onDelete: Cascade)
  candidate      AllStarCandidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([voteSubmissionId, candidateId])
  @@index([candidateId, rating])
}

model AllStarInvite {
  id               String   @id @default(cuid())
  ballotCycleId    String
  tokenHash        String   @unique
  organizationId   String
  ageGroup         String
  invitedEmail     String
  invitedUserId    String?
  createdByAdminId String?
  revokedAt        DateTime?
  openedAt         DateTime?
  expiresAt        DateTime?
  createdAt        DateTime @default(now())

  ballotCycle  AllStarBallotCycle @relation(fields: [ballotCycleId], references: [id], onDelete: Cascade)
  invitedUser  RegisteredUser?    @relation("AllStarInviteRegisteredUser", fields: [invitedUserId], references: [id], onDelete: SetNull)
  createdByAdmin AdminUser?       @relation("AllStarInviteCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([ballotCycleId, invitedEmail])
  @@index([organizationId, ageGroup])
}

model AllStarVaultAccess {
  id               String   @id @default(cuid())
  registeredUserId String
  organizationId   String
  role             AllStarVaultRole
  grantedByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  registeredUser RegisteredUser @relation(fields: [registeredUserId], references: [id], onDelete: Cascade)
  grantedByAdmin AdminUser?     @relation("AllStarVaultAccessGrantedByAdmin", fields: [grantedByAdminId], references: [id], onDelete: SetNull)

  @@unique([registeredUserId, organizationId])
  @@index([organizationId, role, updatedAt])
}

model Team {
  id                String   @id @default(cuid())
  organizationId    String
  seasonYear        Int
  ageGroup          String
  teamName          String
  contactNotes      String?
  practicePlan      String?
  createdByAdminId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  createdByAdmin    AdminUser?             @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  coachAssignments  TeamCoachAssignment[]
  players           TeamPlayer[]
  gameNotes         TeamGameNote[]

  @@unique([organizationId, seasonYear, ageGroup, teamName])
  @@index([organizationId, seasonYear, ageGroup])
}

model TeamCoachAssignment {
  id               String        @id @default(cuid())
  teamId           String
  registeredUserId String
  role             TeamCoachRole @default(ASSISTANT_COACH)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  team           Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  registeredUser RegisteredUser @relation(fields: [registeredUserId], references: [id], onDelete: Cascade)

  @@unique([teamId, registeredUserId])
  @@index([registeredUserId, role])
}

model TeamPlayer {
  id            String   @id @default(cuid())
  teamId         String
  firstName      String?
  lastName       String?
  fullName       String
  contactPhone   String?
  gender         String?
  birthDate      DateTime?
  guardianFirstName String?
  guardianLastName  String?
  guardianEmail     String?
  guardianPhone     String?
  paymentStatus     String?
  birthCertificateStatus String?
  registrationOrderNo    String?
  registrationOrderDate  DateTime?
  jerseySize            String?
  medicalConditionsSummary String?
  medicalConditionsDetails String?
  medicalTreatmentAuthorized Boolean?
  liabilityWaiverAccepted     Boolean?
  codeOfConductAccepted       Boolean?
  refundPolicyAccepted        Boolean?
  playedPriorSeason           Boolean?
  priorSeasonTeamInfo         String?
  streetAddress               String?
  unit                        String?
  city                        String?
  state                       String?
  postalCode                  String?
  rosterStatus   String?
  jerseyNumber   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, fullName])
}

model TeamGameNote {
  id               String   @id @default(cuid())
  teamId           String
  gameExternalId   String
  note             String?
  availabilityNote String?
  authoredByUserId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  team       Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  authoredBy RegisteredUser @relation("TeamGameNoteAuthor", fields: [authoredByUserId], references: [id], onDelete: Cascade)

  @@unique([teamId, gameExternalId])
  @@index([authoredByUserId, updatedAt])
}

model TeamPlayerImportBatch {
  id             String   @id @default(cuid())
  organizationId String
  createdByAdminId String?
  status         String   @default("RUNNING")
  totalRows      Int      @default(0)
  processedRows  Int      @default(0)
  createdTeams   Int      @default(0)
  createdPlayers Int      @default(0)
  updatedPlayers Int      @default(0)
  skippedRows    Int      @default(0)
  undoPayload    Json
  completedAt    DateTime?
  undoneAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdByAdmin AdminUser? @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt])
}

model Sponsor {
  id             String   @id @default(cuid())
  businessName   String
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  websiteUrl     String?
  logoUrl        String?
  logoMimeType   String?
  logoAlt        String?
  notes          String?
  isActive       Boolean  @default(true)
  startAt        DateTime?
  endAt          DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  packageEnrollment SponsorPackageEnrollment?
  placements        SponsorPlacement[]

  @@index([businessName])
  @@index([isActive, startAt, endAt])
}

model SponsorPackageEnrollment {
  id                             String            @id @default(cuid())
  sponsorId                      String            @unique
  packageType                    SponsorPackageType
  packageLabel                   String
  minimumCommitmentCents         Int?
  amountCents                    Int?
  additionalTeamAmountCents      Int?
  twoYearCommitmentAmountCents   Int?
  includesWebsiteLogo            Boolean           @default(true)
  includesSocialRecognition      Boolean           @default(false)
  includesUniformName            Boolean           @default(false)
  includesFieldSignage           Boolean           @default(false)
  includesSeasonScheduleName     Boolean           @default(false)
  includesAllStarMention         Boolean           @default(false)
  notes                          String?
  createdAt                      DateTime          @default(now())
  updatedAt                      DateTime          @updatedAt

  sponsor Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
}

model SponsorPlacement {
  id                  String   @id @default(cuid())
  sponsorId           String
  organizationId      String
  showInFooterScroller Boolean @default(true)
  sortOrder           Int      @default(100)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sponsor Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@unique([sponsorId, organizationId])
  @@index([organizationId, showInFooterScroller, sortOrder])
}

model SocialPost {
  id                   String           @id @default(cuid())
  /** Always `ap-baseball`: shared AP Baseball Facebook Page, not per league site. */
  organizationId     String           @default("ap-baseball")
  status               SocialPostStatus @default(DRAFT)
  body                 String
  linkUrl              String?
  imageUrl             String?
  facebookPostId       String?
  publishError         String?
  publishedAt          DateTime?
  scheduledFor         DateTime?
  createdByAdminId     String?
  /** True when this row was first created from a Facebook Page feed sync (not composed in admin). */
  syncedFromFacebook   Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  createdByAdmin AdminUser? @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@unique([organizationId, facebookPostId])
  @@index([organizationId, status, updatedAt])
}

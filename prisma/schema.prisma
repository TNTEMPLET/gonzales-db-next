/// Per-org configuration for the public All-Star information page.
model AllStarPageConfig {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  /// Customizable label shown on the PayPal button (e.g. "2026 All-Star Fee Payment")
  paypalLinkLabel String?
  /// Full PayPal payment URL
  paypalLinkUrl   String?
  /// Plain-text announcement / info paragraph shown at the top of the page
  infoText        String?
  /// Additional purchasable items: JSON array of { label: string, url: string }
  links           Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Fee payment record for a player selected for All-Stars. Populated from the ballot cycle
/// roster and reconciled against PayPal transactions.
model AllStarPayment {
  id                  String    @id @default(cuid())
  organizationId      String
  ballotCycleId       String
  /// Linked candidate – null if manually added outside ballot cycle roster.
  candidateId         String?
  playerFullName      String
  ageGroup            String
  team                String
  /// Payer name as reported by PayPal (filled during sync).
  payerName           String?
  /// PayPal transaction ID (filled during sync).
  paypalTxId          String?
  /// Date/time of the PayPal payment (filled during sync).
  paypalTxDate        DateTime?
  /// Raw PayPal memo / note field used for player matching.
  paypalNote          String?
  /// Amount in cents (default 9500 = 5.00).
  amountCents         Int       @default(9500)
  isPaid              Boolean   @default(false)
  paidAt              DateTime?
  markedPaidByAdminId String?
  /// Optional free-text note from admin.
  notes               String?
  /// Roster label grouping payments (e.g. "2026 — 11U LLB — Navy"). Null for legacy records.
  rosterTag           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  ballotCycle       AllStarBallotCycle @relation(fields: [ballotCycleId], references: [id], onDelete: Cascade)
  candidate         AllStarCandidate?  @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  markedPaidByAdmin AdminUser?         @relation("AllStarPaymentMarkedPaidBy", fields: [markedPaidByAdminId], references: [id], onDelete: SetNull)

  /// One record per candidate per cycle; manual records (candidateId null) have no uniqueness constraint.
  @@unique([ballotCycleId, candidateId])
  @@index([organizationId, ballotCycleId])
  @@index([ballotCycleId, isPaid])
}


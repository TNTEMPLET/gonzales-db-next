generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

enum AdminAuditAction {
  PROMOTE
  DEMOTE
  BLOCK
  UNBLOCK
  REMOVE
  GRANT_MASTER
  REVOKE_MASTER
  MERGE_USERS
}

enum AdminRole {
  MASTER_ADMIN
  ADMIN
  BOARD_MEMBER
  PARK_DIRECTOR
}

enum AllStarCycleStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum AllStarAccessMode {
  INVITE_LIST
  AGE_GROUP_COACHES
}

enum AllStarBallotPhase {
  FIRST_TEAM
  SECOND_TEAM
}

enum AllStarFinalRosterOverride {
  SELECTED
  REMOVED
  SECOND_TEAM
}

enum AllStarVaultRole {
  FULL_ACCESS
  LIMITED_ADMIN
}

enum AllStarAuditAction {
  FINAL_ROSTER_OVERRIDE
  FINAL_ROSTER_BULK_FINALIZE
  SECOND_PHASE_OVERRIDE
  CANDIDATE_CREATED
  CANDIDATE_UPDATED
  CANDIDATE_DELETED
  CANDIDATE_IMPORTED
  CYCLE_CREATED
  CYCLE_UPDATED
  CYCLE_DELETED
  INVITE_ROSTER_SAVED
  INVITE_REVOKED
  INVITE_REENABLED
  VAULT_ACCESS_UPSERT
  VAULT_ACCESS_REVOKED
  HEAD_COACH_ADDED
  HEAD_COACH_REMOVED
  BALLOT_LINK_GENERATED
  VOTE_SUBMISSION_DELETED
}

enum TeamCoachRole {
  HEAD_COACH
  ASSISTANT_COACH
}

enum SponsorPackageType {
  BALLPARK_FENCE_SIGNS
  TEAM_SPONSORSHIPS
  FIELD_SPONSORSHIPS
  CUSTOM
}

enum DugoutMediaType {
  IMAGE
  GIF
}

enum DugoutNotificationEntityType {
  POST_LIKE
  COMMENT
}

enum RegisteredUserDuplicateMatchReason {
  NAME_NORMALIZED
}

enum RegisteredUserDuplicateStatus {
  PENDING
  DISMISSED
  MERGED
}

enum SocialPostStatus {
  DRAFT
  PUBLISHING
  PUBLISHED
  FAILED
}

enum CommunicationChannel {
  EMAIL
  SMS
}

enum CommunicationCampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELED
}

enum CommunicationApprovalStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum CommunicationAudienceLogicalMode {
  AND
  OR
}

enum CommunicationAudienceRuleType {
  ALL_USERS
  ORGANIZATION
  ALL_COACHES
  ORGANIZATION_COACHES
  COACHING_INTEREST
  ADMIN_ROLE
  EXPLICIT_USERS
}

enum CommunicationRecipientType {
  REGISTERED_USER
  ADMIN_USER
  COACHING_INTEREST
}

enum CommunicationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_SUPPRESSED
  SKIPPED_NO_CONSENT
  SKIPPED_NO_CONTACT
}

enum CoachingInterestRolePreference {
  HEAD_COACH
  ASSISTANT_COACH
  EITHER
}

enum CoachingInterestStatus {
  NEW
  CONTACTED
  NOT_INTERESTED
  CONVERTED
  ARCHIVED
}

enum TournamentIncomeCategory {
  ENTRY_FEE
  SPONSOR
  MERCHANDISE
  GATE
  OTHER
}

enum TournamentIncomeClassificationStatus {
  MATCHED
  UNMATCHED
  IGNORED
  MANUAL
}

enum ScheduleSeasonStatus {
  DRAFT
  ACTIVE
  LOCKED
  ARCHIVED
}

enum ScheduleAvailabilityType {
  AVAILABLE
  BLACKOUT
}

enum ScheduleDraftGameStatus {
  DRAFT
  READY
  CONFLICT
  LOCKED
  EXPORTED
  CANCELED
}

enum ScheduleExportBatchStatus {
  PENDING
  COMPLETED
  FAILED
}

model NewsPost {
  id             String     @id @default(cuid())
  organizationId String     @default("gonzales")
  title          String
  slug           String
  excerpt        String?
  content        String
  imageUrl       String?
  author         String?
  featured       Boolean    @default(false)
  rotatorEnabled Boolean    @default(false)
  status         NewsStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId, status, publishedAt])
  @@index([organizationId, slug])
}

model AdminUser {
  id                               String                            @id @default(cuid())
  email                            String                            @unique
  name                             String?
  firstName                        String?
  lastName                         String?
  role                             AdminRole                         @default(ADMIN)
  isMaster                         Boolean                           @default(false)
  passwordHash                     String?
  avatarUrl                        String?
  /// Set when the admin signs in with Google; required to open org Drive files in the browser.
  googleSub                        String?                           @unique
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  sessions                         AdminSession[]
  auditLogs                        AdminAuditLog[]                   @relation("AdminActorLogs")
  enteredScores                    GameScore[]
  gameChangerScoreboardConnections GameChangerScoreboardConnection[] @relation("GameChangerScoreboardConnectionCreatedBy")
  coachImportBatches               CoachImportBatch[]
  allStarBallotCycles              AllStarBallotCycle[]              @relation("AllStarCycleCreatedBy")
  allStarHeadCoachAssignments      AllStarHeadCoachAssignment[]      @relation("AllStarHeadCoachAdmin")
  allStarInvites                   AllStarInvite[]                   @relation("AllStarInviteCreatedByAdmin")
  allStarSecondPhaseOverrides      AllStarCandidate[]                @relation("AllStarSecondPhaseOverrideByAdmin")
  allStarFinalRosterOverrides      AllStarCandidate[]                @relation("AllStarFinalRosterOverrideByAdmin")
  allStarVaultAccessGrants         AllStarVaultAccess[]              @relation("AllStarVaultAccessGrantedByAdmin")
  teamsCreated                     Team[]
  teamPlayerImportBatches          TeamPlayerImportBatch[]
  socialPostsCreated               SocialPost[]
  orgMemberships                   AdminOrgMembership[]
  communicationsCreated            CommunicationCampaign[]           @relation("CommunicationCampaignCreatedBy")
  communicationsApproved           CommunicationApproval[]           @relation("CommunicationApprovedBy")
  communicationRecipientSnapshots  CommunicationRecipientSnapshot[]  @relation("CommunicationRecipientAdminUser")
  communicationDeliveries          CommunicationDelivery[]           @relation("CommunicationDeliveryAdminUser")
  communicationFromAddressesCreated CommunicationFromAddress[]       @relation("CommunicationFromAddressCreatedBy")
  assignrSyncJobsCreated           AssignrSyncJob[]                  @relation("AssignrSyncJobCreatedBy")
  assignrAuditLogs                 AssignrAuditLog[]                 @relation("AssignrAuditActor")
  bracketProjectsCreated           BracketProject[]                  @relation("BracketProjectCreatedBy")
  governingBodyTemplatesCreated    GoverningBodyTemplate[]           @relation("GoverningBodyTemplateCreatedBy")
  scheduleManagerJobsCreated       ScheduleManagerJob[]              @relation("ScheduleManagerJobCreatedBy")
  allStarAuditLogsActed            AllStarAuditLog[]                 @relation("AllStarAuditActor")
  allStarAuditLogsReverted         AllStarAuditLog[]                 @relation("AllStarAuditReverter")
  allStarPaymentsMarkedPaid        AllStarPayment[]                  @relation("AllStarPaymentMarkedPaidBy")
  parkInfoPagesUpdated             ParkInfoPage[]                    @relation("ParkInfoUpdatedBy")
  scheduleSeasonsCreated           ScheduleSeason[]                  @relation("ScheduleSeasonCreatedBy")
  scheduleExportBatchesCreated     ScheduleExportBatch[]             @relation("ScheduleExportBatchCreatedBy")
  volunteerRequirementsReviewed    VolunteerRequirementStatus[]      @relation("VolunteerRequirementReviewedBy")
  volunteerRoleDefsCreated         VolunteerRoleDef[]                @relation("VolunteerRoleDefCreatedBy")
}

enum BracketProjectStatus {
  DRAFT
  READY
  ARCHIVED
}

/// Uploaded governing-body bracket / schedule template (PDF, XLSX, etc.) for reuse.
model GoverningBodyTemplate {
  id               String   @id @default(cuid())
  organizationId   String
  governingBody    String
  label            String
  parserProfileId  String?
  fileUrl          String
  fileMime         String?
  notes            String?
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdByAdmin  AdminUser?       @relation("GoverningBodyTemplateCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  bracketProjects BracketProject[]

  @@index([organizationId, governingBody])
}

/// End-of-year or tournament bracket project: canonical spec JSON plus source artifact URLs.
model BracketProject {
  id                      String               @id @default(cuid())
  organizationId          String
  seasonYear              Int
  name                    String
  status                  BracketProjectStatus @default(DRAFT)
  /// Lower numbers sort first when bracket priority ordering is used.
  priority                Int                  @default(0)
  /// Versioned bracket spec (structure, games, flyer options, ingestion warnings).
  spec                    Json                 @default("{}")
  /// Vercel Blob (or other) URLs for originals: templates, screenshots, logos, sponsor assets.
  sourceArtifactUrls      Json                 @default("[]")
  governingBodyTemplateId String?
  createdByAdminId        String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  governingBodyTemplate   GoverningBodyTemplate?        @relation(fields: [governingBodyTemplateId], references: [id], onDelete: SetNull)
  createdByAdmin          AdminUser?                    @relation("BracketProjectCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  incomeTransactions      TournamentIncomeTransaction[]
  scheduleManagerActions  ScheduleManagerAction[]
  tournamentMonitorEvents TournamentMonitorEvent[]

  @@index([organizationId, status, updatedAt])
  @@index([organizationId, priority])
  @@index([createdByAdminId])
}

/// Effective admin role for a specific organization (gonzales | ascension).
/// Master Admin (`AdminUser.isMaster`) does not require a row — they apply everywhere.

model TournamentIncomeTransaction {
  id                   String                               @id @default(cuid())
  organizationId       String
  seasonYear           Int
  bracketProjectId     String?
  category             TournamentIncomeCategory             @default(OTHER)
  paypalTxId           String
  paypalTxDate         DateTime
  paypalStatus         String?
  payerName            String?
  payerEmail           String?
  itemName             String?
  paypalNote           String?
  paypalMemo           String?
  grossAmountCents     Int
  feeAmountCents       Int                                  @default(0)
  netAmountCents       Int
  classificationStatus TournamentIncomeClassificationStatus @default(UNMATCHED)
  adminNotes           String?
  createdAt            DateTime                             @default(now())
  updatedAt            DateTime                             @updatedAt

  bracketProject BracketProject? @relation(fields: [bracketProjectId], references: [id], onDelete: SetNull)

  @@unique([organizationId, paypalTxId], map: "TIncomeTx_org_paypalTx_key")
  @@index([organizationId, paypalTxDate], map: "TIncomeTx_org_paypalDate_idx")
  @@index([organizationId, seasonYear, category], map: "TIncomeTx_org_season_category_idx")
  @@index([organizationId, classificationStatus], map: "TIncomeTx_org_classification_idx")
  @@index([organizationId, bracketProjectId], map: "TIncomeTx_org_bracket_idx")
  @@index([bracketProjectId], map: "TIncomeTx_bracket_idx")
}

model TournamentRosterIntakeLink {
  id               String    @id @default(cuid())
  organizationId   String
  seasonYear       Int
  bracketProjectId String?
  teamName         String
  ageGroup         String?
  tokenHash        String    @unique
  status           String    @default("ACTIVE")
  createdByAdminId String?
  expiresAt        DateTime?
  disabledAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  submissions TournamentRosterSubmission[]

  @@unique([organizationId, seasonYear, bracketProjectId, teamName], map: "TRosterLink_org_season_project_team_key")
  @@index([organizationId, seasonYear, bracketProjectId], map: "TRosterLink_org_season_project_idx")
  @@index([status, updatedAt], map: "TRosterLink_status_updated_idx")
}

model TournamentRosterSubmission {
  id                String    @id @default(cuid())
  linkId            String
  status            String    @default("PENDING")
  source            String
  submitterName     String?
  submitterEmail    String?
  submitterPhone    String?
  notes             String?
  originalFilename  String?
  rawCsv            String?
  reviewedByAdminId String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  link    TournamentRosterIntakeLink         @relation(fields: [linkId], references: [id], onDelete: Cascade)
  players TournamentRosterSubmissionPlayer[]

  @@index([linkId, status, createdAt], map: "TRosterSubmission_link_status_created_idx")
  @@index([status, createdAt], map: "TRosterSubmission_status_created_idx")
}

model TournamentRosterSubmissionPlayer {
  id              String   @id @default(cuid())
  submissionId    String
  rowNumber       Int
  firstName       String
  lastName        String
  jerseyNumber    String
  validationNotes Json?
  createdAt       DateTime @default(now())

  submission TournamentRosterSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, rowNumber], map: "TRosterPlayer_submission_row_idx")
}

model AdminOrgMembership {
  id             String    @id @default(cuid())
  adminUserId    String
  organizationId String
  role           AdminRole
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  adminUser      AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, organizationId])
  @@index([organizationId, role])
}

model RegisteredUser {
  id                              String                             @id @default(cuid())
  organizationId                  String                             @default("gonzales")
  email                           String
  name                            String?
  firstName                       String?
  lastName                        String?
  isCoach                         Boolean                            @default(false)
  isBlocked                       Boolean                            @default(false)
  contactPhone                    String?
  ageGroup                        String?
  assignedTeam                    String?
  googleSub                       String?                            @unique
  passwordHash                    String?
  avatarUrl                       String?
  abuseAwarenessTrainingCertificateUrl String?
  abuseAwarenessTrainingCertificateFileName String?
  abuseAwarenessTrainingCertificateMimeType String?
  abuseAwarenessTrainingCertificateUploadedAt DateTime?
  /**
   * True when name-based duplicate detection flagged this account for admin review.
   */
  duplicateReviewPending          Boolean                            @default(false)
  createdAt                       DateTime                           @default(now())
  updatedAt                       DateTime                           @updatedAt
  auditLogs                       AdminAuditLog[]
  sessions                        CoachSession[]
  dugoutPosts                     DugoutPost[]
  dugoutComments                  DugoutComment[]
  dugoutLikes                     DugoutPostLike[]
  dugoutNotificationCursor        DugoutNotificationCursor?
  dugoutNotificationReads         DugoutNotificationRead[]
  allStarVoteDrafts               AllStarVoteDraft[]
  allStarVoteSubmissions          AllStarVoteSubmission[]
  allStarHeadCoachAssignments     AllStarHeadCoachAssignment[]       @relation("AllStarHeadCoachRegisteredUser")
  allStarInvites                  AllStarInvite[]                    @relation("AllStarInviteRegisteredUser")
  allStarVaultAccess              AllStarVaultAccess[]
  teamCoachAssignments            TeamCoachAssignment[]
  teamGameNotes                   TeamGameNote[]                     @relation("TeamGameNoteAuthor")
  duplicateAsNewer                RegisteredUserDuplicateCandidate[] @relation("RegisteredUserDuplicateAsNewer")
  duplicateAsCandidate            RegisteredUserDuplicateCandidate[] @relation("RegisteredUserDuplicateAsCandidate")
  communicationsCreated           CommunicationCampaign[]            @relation("CommunicationCampaignCreatedByRegisteredUser")
  communicationRecipientSnapshots CommunicationRecipientSnapshot[]   @relation("CommunicationRecipientRegisteredUser")
  communicationDeliveries         CommunicationDelivery[]            @relation("CommunicationDeliveryRegisteredUser")
  emailSuppressions               EmailSuppression[]
  smsConsents                     SmsConsent[]
  volunteerProfiles               VolunteerProfile[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, duplicateReviewPending])
}

model CoachingInterestSubmission {
  id                 String                         @id @default(cuid())
  organizationId     String                         @default("fallball")
  firstName          String
  lastName           String
  email              String
  cellPhone          String
  interestedDivision String
  rolePreference     CoachingInterestRolePreference @default(EITHER)
  hasCoachedBefore   Boolean                        @default(false)
  priorDivision      String?
  notes              String?
  status             CoachingInterestStatus         @default(NEW)
  adminNotes         String?
  contactedAt        DateTime?
  convertedAt        DateTime?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@index([organizationId, rolePreference])
  @@index([organizationId, interestedDivision])
  @@index([createdAt])
}

model RegisteredUserDuplicateCandidate {
  id              String                             @id @default(cuid())
  organizationId  String
  newerUserId     String
  candidateUserId String
  matchReason     RegisteredUserDuplicateMatchReason @default(NAME_NORMALIZED)
  status          RegisteredUserDuplicateStatus      @default(PENDING)
  createdAt       DateTime                           @default(now())
  resolvedAt      DateTime?

  newerUser     RegisteredUser @relation("RegisteredUserDuplicateAsNewer", fields: [newerUserId], references: [id], onDelete: Cascade)
  candidateUser RegisteredUser @relation("RegisteredUserDuplicateAsCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)

  @@unique([newerUserId, candidateUserId])
  @@index([organizationId, status])
  @@index([newerUserId, status])
}

model CoachSession {
  id        String         @id @default(cuid())
  tokenHash String         @unique
  expiresAt DateTime
  createdAt DateTime       @default(now())
  userId    String
  user      RegisteredUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model DugoutPost {
  id             String           @id @default(cuid())
  organizationId String           @default("gonzales")
  content        String
  mediaUrl       String?
  mediaType      DugoutMediaType?
  threadId       String?
  threadOrder    Int?
  isPinned       Boolean          @default(false)
  pinnedAt       DateTime?
  authorId       String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  author   RegisteredUser   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments DugoutComment[]
  likes    DugoutPostLike[]

  @@index([organizationId, createdAt])
  @@index([authorId])
  @@index([threadId, threadOrder])
  @@index([isPinned, pinnedAt])
}

model DugoutComment {
  id        String           @id @default(cuid())
  content   String
  mediaUrl  String?
  mediaType DugoutMediaType?
  postId    String
  authorId  String
  parentId  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  post              DugoutPost               @relation(fields: [postId], references: [id], onDelete: Cascade)
  author            RegisteredUser           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent            DugoutComment?           @relation("DugoutCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies           DugoutComment[]          @relation("DugoutCommentReplies")
  notificationReads DugoutNotificationRead[] @relation("NotificationReadComment")

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId])
}

model DugoutPostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  reaction  String   @default("👍")
  createdAt DateTime @default(now())

  post              DugoutPost               @relation(fields: [postId], references: [id], onDelete: Cascade)
  user              RegisteredUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationReads DugoutNotificationRead[] @relation("NotificationReadLike")

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model DugoutNotificationCursor {
  id         String   @id @default(cuid())
  userId     String   @unique
  lastSeenAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user RegisteredUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastSeenAt])
}

model DugoutNotificationRead {
  id         String                       @id @default(cuid())
  userId     String
  entityType DugoutNotificationEntityType
  postLikeId String?
  commentId  String?
  readAt     DateTime                     @default(now())

  user     RegisteredUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  postLike DugoutPostLike? @relation("NotificationReadLike", fields: [postLikeId], references: [id], onDelete: Cascade)
  comment  DugoutComment?  @relation("NotificationReadComment", fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postLikeId])
  @@unique([userId, commentId])
  @@index([userId, readAt])
  @@index([entityType, readAt])
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AdminAuditLog {
  id                     String           @id @default(cuid())
  action                 AdminAuditAction
  actorAdminId           String?
  actorEmail             String
  targetAdminId          String?
  targetRegisteredUserId String?
  targetEmail            String
  targetName             String?
  sourcePath             String?
  requestIp              String?
  createdAt              DateTime         @default(now())

  actorAdmin           AdminUser?      @relation("AdminActorLogs", fields: [actorAdminId], references: [id], onDelete: SetNull)
  targetRegisteredUser RegisteredUser? @relation(fields: [targetRegisteredUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
}

model CommunicationCampaign {
  id                        String                           @id @default(cuid())
  organizationId            String?
  logicalMode               CommunicationAudienceLogicalMode @default(AND)
  channels                  CommunicationChannel[]
  status                    CommunicationCampaignStatus      @default(DRAFT)
  title                     String
  messageSubject            String?
  messageBody               String
  /// Resend From header, e.g. "AP Baseball <noreply@apbaseball.com>". Null = env/default.
  fromEmail                 String?
  createdByAdminId          String?
  createdByRegisteredUserId String?
  sendAt                    DateTime?
  timezone                  String?
  quietHoursStart           Int?
  quietHoursEnd             Int?
  approvedAt                DateTime?
  sentAt                    DateTime?
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt

  createdByAdmin          AdminUser?                       @relation("CommunicationCampaignCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdByRegisteredUser RegisteredUser?                  @relation("CommunicationCampaignCreatedByRegisteredUser", fields: [createdByRegisteredUserId], references: [id], onDelete: SetNull)
  audienceRules           CommunicationAudienceRule[]
  approvals               CommunicationApproval[]
  recipientSnapshots      CommunicationRecipientSnapshot[]
  deliveries              CommunicationDelivery[]

  @@index([status, sendAt])
  @@index([organizationId, createdAt])
}

/// Master-admin managed From identities for Communications (Resend). No redeploy needed to change options.
model CommunicationFromAddress {
  id              String   @id @default(cuid())
  /// Full Resend From header, e.g. "AP Baseball <noreply@apbaseball.com>"
  fromHeader      String   @unique
  label           String?
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdByAdminId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdByAdmin AdminUser? @relation("CommunicationFromAddressCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder])
  @@index([isDefault])
}

model CommunicationAudienceRule {
  id                        String                        @id @default(cuid())
  campaignId                String
  ruleType                  CommunicationAudienceRuleType
  organizationId            String?
  adminRole                 AdminRole?
  coachingInterestStatus    CoachingInterestStatus?
  /// RegisteredUser ids when ruleType is EXPLICIT_USERS (Users-page multi-select).
  explicitRegisteredUserIds String[]                      @default([])
  createdAt                 DateTime                      @default(now())

  campaign CommunicationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([ruleType, organizationId, adminRole])
  @@index([ruleType, organizationId, coachingInterestStatus])
}

model CommunicationApproval {
  id              String                      @id @default(cuid())
  campaignId      String
  approverAdminId String?
  status          CommunicationApprovalStatus
  note            String?
  actedAt         DateTime                    @default(now())
  createdAt       DateTime                    @default(now())

  campaign      CommunicationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  approverAdmin AdminUser?            @relation("CommunicationApprovedBy", fields: [approverAdminId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([approverAdminId, actedAt])
}

model CommunicationRecipientSnapshot {
  id               String                     @id @default(cuid())
  campaignId       String
  recipientType    CommunicationRecipientType
  registeredUserId String?
  adminUserId      String?
  email            String?
  phone            String?
  matchReasons     String[]
  createdAt        DateTime                   @default(now())

  campaign       CommunicationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  registeredUser RegisteredUser?       @relation("CommunicationRecipientRegisteredUser", fields: [registeredUserId], references: [id], onDelete: SetNull)
  adminUser      AdminUser?            @relation("CommunicationRecipientAdminUser", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([registeredUserId])
  @@index([adminUserId])
}

model CommunicationDelivery {
  id                String                      @id @default(cuid())
  campaignId        String
  channel           CommunicationChannel
  recipientType     CommunicationRecipientType
  registeredUserId  String?

// ─── Championship / merchandise shirt orders ────────────────────────────────

model ShirtOrderRecord {
  id          String   @id @default(cuid())
  txId        String   @unique
  org         String // "gonzales" | "ascension" | "unknown"
  payerName   String?
  payerEmail  String?
  amountCents Int
  quantity    Int      @default(1)
  note        String?
  itemName    String?
  txDate      DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


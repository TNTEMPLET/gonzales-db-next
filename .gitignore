# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma local db
/prisma/dev.db
/prisma/dev.db-journal

# Tournament bracket builder: local logo uploads (folder kept via .gitkeep)
/public/uploads/tournament-brackets/*
!/public/uploads/tournament-brackets/.gitkeep

# One-off agent refactor tooling (not shipped with the app)
scripts/refactor-*.mjs
scripts/apply-minimal-*.py
scripts/*-ui-helpers.txt

# Local data exports (PII — never commit)
/exports/
/public/exports/

# Local audit / one-off data fix scripts (keep on dev-box only)
scripts/check-*.ts
scripts/fix-*.ts
scripts/dump-brackets.ts
scripts/migrate-6u-*.ts
scripts/restore-*.ts
scripts/get-cycle-ids.ts

# Per-org dev distDirs
.next-gonzales
.next-ascension
.next-master
.next-ladistrict2
.next-ladistrict6

# Claude Code project memory (local AI session data)
.claude/

.next-fallball/
.next-public/

# Prefer pnpm — do not commit npm lockfile
package-lock.json
.env*.local
